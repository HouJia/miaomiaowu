# =============================================================================
# 源仓默认部署（根路径，与 upstream 一致）
#
# 场景：站点根路径 /，使用 build.sh 构建，cmd/server 启动。
# 使用：cp .env.default .env  →  ./build.sh
#
# Fork 子路径 /mmw/（NAS + NPM）请改用：cp .env.example .env
# 图例：【必改】 【可改】 【沿用默认·不必改】
# =============================================================================

# ── 【沿用默认·不必改】后端运行时 ─────────────────────────────────────────

PORT=8080
DATABASE_PATH=/app/data/traffic.db
LOG_LEVEL=info

# ── 【沿用默认·不必改】前端开发代理（仅 vite dev 生效）────────────────────

VITE_API_URL=http://localhost:8080

# ── 【沿用默认·不必改】根路径：不设 BASE_PATH / VITE_BASE_PATH ───────────
# fork 子路径变量见 .env.example
