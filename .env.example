# =============================================================================
# Fork 子路径部署模板（脱敏，可提交 Git）
#
# 选文件：
#   .env.default  → 根路径 + build.sh，【必改】0 项
#   .env.example  → 本文件：/mmw/ + build-fork.sh，默认【必改】0 项
#
# 使用：cp .env.example .env  →  按需改【必改】【可改】→  ./scripts/build-fork.sh
# 图例：【必改】 【可改】 【沿用默认·不必改】
# =============================================================================

# ── 【沿用默认·不必改】与 fork 开箱默认一致（NPM location /mmw/）──────────

# 后端子路径（无末尾 /）；与 Nginx location、VITE_BASE_PATH 对应
BASE_PATH=/mmw

# 前端 Vite base（必须以 / 开头并以 / 结尾）
VITE_BASE_PATH=/mmw/

# ── 【必改】仅当更换子路径前缀时（2 项须同时改、与 Nginx 一致）────────────
# BASE_PATH=/other
# VITE_BASE_PATH=/other/

# ── 【可改】按需调整 ─────────────────────────────────────────────────────

# 内外网域名不一致、或 Clash 订阅需固定公网域名时设置（勿带路径、勿末尾 /）
# PUBLIC_ORIGIN=https://nas.example.com

PORT=8080
DATABASE_PATH=/app/data/traffic.db
LOG_LEVEL=info

# 前端开发代理后端地址（仅 vite dev）
VITE_API_URL=http://localhost:8080

# CORS / 前端来源（多域名时用逗号分隔；一般 NPM 同域可不改）
# ALLOWED_ORIGINS=https://nas.example.com
# FRONTEND_ORIGIN=https://nas.example.com
